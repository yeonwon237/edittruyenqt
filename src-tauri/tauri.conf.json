{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LilyNovel",
  "version": "0.1.0",
  "identifier": "vn.edittruyenqt.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5186",
    "beforeDevCommand": "npm run dev -- --port 5186 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LilyNovel",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ct2_models": "nmt/ct2_models",
      "resources/pronoun_clf": "nmt/pronoun_clf"
    },
    "externalBin": ["binaries/nmt-server"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
