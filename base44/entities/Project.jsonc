{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "T\u00ean b\u1ed9 truy\u1ec7n"
    },
    "description": {
      "type": "string",
      "title": "M\u00f4 t\u1ea3"
    },
    "source_language": {
      "type": "string",
      "default": "Trung",
      "title": "Ng\u00f4n ng\u1eef g\u1ed1c"
    },
    "cover_emoji": {
      "type": "string",
      "default": "\ud83d\udcda"
    },
    "custom_field_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "batch_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "find": {
            "type": "string"
          },
          "replace": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "pronoun_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "from_words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to_words": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "default": []
    },
    "contextual_pronoun_rules": {
      "type": "array",
      "title": "Ma tr\u1eadn X\u01b0ng h\u00f4 theo ng\u1eef c\u1ea3nh",
      "items": {
        "type": "object",
        "properties": {
          "speaker": {
            "type": "string",
            "title": "Ng\u01b0\u1eddi n\u00f3i (Nh\u00e2n v\u1eadt)"
          },
          "listener": {
            "type": "string",
            "title": "Ng\u01b0\u1eddi nghe (* = t\u1ea5t c\u1ea3 m\u1ecdi ng\u01b0\u1eddi)"
          },
          "self_word": {
            "type": "string",
            "title": "C\u00e1ch x\u01b0ng (x\u01b0ng l\u00e0)"
          },
          "target_word": {
            "type": "string",
            "title": "C\u00e1ch g\u1ecdi \u0111\u1ed1i ph\u01b0\u01a1ng"
          },
          "note": {
            "type": "string",
            "title": "Ghi ch\u00fa"
          }
        }
      },
      "default": []
    },
    "visible_columns": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "raw",
          "qt",
          "edited"
        ]
      },
      "default": [
        "raw",
        "qt",
        "edited"
      ],
      "title": "C\u1ed9t hi\u1ec3n th\u1ecb trong Workspace"
    }
  },
  "required": [
    "title"
  ]
}